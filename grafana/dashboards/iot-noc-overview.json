    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Minimum health across Prometheus, Mosquitto exporter, cAdvisor, and Alertmanager.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "DEGRADED"
                },
                "1": {
                  "color": "green",
                  "text": "HEALTHY"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "pluginVersion": "13.1.2",
      "targets": [
        {
          "editorMode": "code",
          "expr": "min(up{job=~\"prometheus|mosquitto|cadvisor|alertmanager\"})",
          "instant": true,
          "legendFormat": "health",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Monitoring Stack",
      "type": "stat"
    },
